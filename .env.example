APP_ENV=development
FLASK_SECRET_KEY=replace-with-a-long-random-value
BALLOT_SECRET=replace-with-another-long-random-value
ADMIN_USERNAME=securevote-admin
ADMIN_PASSWORD=replace-with-at-least-12-characters
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-new-securevote-email@gmail.com
SMTP_PASS=your-16-character-google-app-password
SMTP_FROM_NAME=SecureVote
EMAIL_PROVIDER=smtp
BREVO_API_KEY=your-brevo-api-key
ALLOW_DEV_OTP=true
SHOW_LIVE_RESULTS=false
DATA_DIR=./data
ALLOW_EPHEMERAL_DATA=false
